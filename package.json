{
  "name": "the-living-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "db:check": "node scripts/check-migrations.mjs && npm run test:db",
    "test:db": "node --import tsx --test tests/database.test.ts tests/checkout-setup.test.ts",
    "test:unit": "node --import tsx --test tests/validation.test.ts",
    "db:seed:generate": "node --import tsx scripts/generate-verified-seed.ts",
    "test:commerce": "node --import tsx --test tests/commerce.test.ts",
    "ebooks:upload": "node --import tsx scripts/upload-approved-ebooks.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
