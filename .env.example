# Public origin; use the real HTTPS origin before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, only after the author approves the public address:
NEXT_PUBLIC_CONTACT_EMAIL=edmund.katso@gmail.com
# Enable only after Supabase migrations and publishing checks are complete.
BACKEND_ENABLED=false
# Public Supabase configuration for catalog and administrator sign-in.
# Use a publishable key (sb_publishable_...) or a legacy anon key only.
# Never put a secret or service-role key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only commerce integrations. Keep COMMERCE_ENABLED=false until setup is verified.
# Server-only credentials: never prefix these names with NEXT_PUBLIC_.
# Use Stripe test-mode credentials during development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Trusted commerce worker access; never used by the public browser.
SUPABASE_SECRET_KEY=
# Brevo automatic purchase/download emails. See docs/BREVO_SETUP.md.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Edmund Spencer Katso

# Direct ebook commerce: keep disabled until migrations, private files and tests pass.
COMMERCE_ENABLED=false
STRIPE_MODE=test
LIVE_PAYMENTS_ENABLED=false
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_EBOOK_TAX_CODE=
PURCHASE_TERMS_APPROVED=false
CRON_SECRET=
COMMERCE_RATE_LIMIT_SECRET=
TRANSACTIONAL_EMAIL_ENABLED=false
STRIPE_TEST_BUYER_EMAIL=edmund.katso@gmail.com

# Keep search indexing off until the public launch review is complete.
SEARCH_INDEXING_ENABLED=false
