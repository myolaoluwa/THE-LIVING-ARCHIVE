# Public origin; use the real HTTPS origin before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, only after the author approves the public address:
NEXT_PUBLIC_CONTACT_EMAIL=edmund.katso@gmail.com
# Backend is postponed. Keep false for the source-managed public website.
BACKEND_ENABLED=false
# Future Phase 3: enable explicitly only after migrations and security checks.
# Use a publishable key (sb_publishable_...) or a legacy anon key only.
# Never put a secret or service-role key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
